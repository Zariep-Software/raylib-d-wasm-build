# Configuration for build-web.d (parsed as KEY=VALUE lines, not executed).
# Supports ~, $VAR and ${VAR} expansion. Uncomment and adjust.

# REQUIRED: directory containing libraylib.web.a (or libraylib.a) from the
# raylib webassembly release zip.
RAYLIB_WEB_LIB_DIR=~/libs/raylib-web/lib

# Optional: emsdk root (its upstream/emscripten dir is added to PATH).
# EMSDK_DIR=~/emsdk

# Optional: raylib-d import path (default: ./source if it has raylib/, else dub describe).
# RAYLIB_D_IMPORT=~/projects/raylib-d/source

# Optional: custom HTML shell (must contain {{{ SCRIPT }}}) and CSS.
# The CSS replaces the `/* WEB_CSS */` marker in the shell, or is injected before </head>.
# WEB_SHELL_PATH=web/custom_shell.html
# WEB_CSS_PATH=web/style.css

# Optional: layout and memory.
# WEB_SOURCE_DIR=source
# WEB_ASSETS_DIR=assets
# WEB_OUTPUT_DIR=web
# INITIAL_MEMORY=67108864

# Optional: extra flags (each token is passed to emcc via --Xcc=).
# EXTRA_CFLAGS=
# EXTRA_LDFLAGS=-sASYNCIFY
# EXTRA_DFLAGS=
